{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "authors",
    "boundaries",
    "dna",
    "sources",
    "workflows",
    "connectors"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 100,
      "pattern": "^[^\\r\\n]+$",
      "description": "100–250 non-whitespace characters; checked by the maintenance script."
    },
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      },
      "description": "Human author IDs from one team; empty when unknown. References and team membership checked by maintenance script."
    },
    "boundaries": {
      "type": "string",
      "minLength": 1
    },
    "dna": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/knowledge"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "connectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.cbim/connectors/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
      }
    }
  },
  "$defs": {
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "scope"
      ],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "trigger",
        "reference"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
