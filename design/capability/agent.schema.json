{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "authors",
    "capabilities",
    "limitations",
    "work_principles",
    "skills",
    "connectors"
  ],
  "properties": {
    "authors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      },
      "description": "Human author IDs from one team; empty when unknown. References and team membership checked by maintenance script."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 100,
      "pattern": "^[^\\r\\n]+$",
      "description": "100–250 non-whitespace characters; semantic content authored by an Agent."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "work_principles": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      },
      "description": "Only Agent-owned skills; inherited Team skills are resolved at load time."
    },
    "connectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.cbim/connectors/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "reference"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^skills/[^/]+/SKILL\\.md$"
        }
      }
    }
  }
}
