{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team shared Skill inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skills"
  ],
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "reference"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "pattern": "^skills/[^/]+/SKILL\\.md$"
          }
        }
      }
    }
  }
}
