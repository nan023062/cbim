{
  "name": "cbim-assistant",
  "productName": "CBIM Assistant",
  "version": "0.1.2",
  "private": true,
  "description": "AI Native workflow assistant for teams",
  "author": "CBIM",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "loop": "tsx src/backend/main/commands/loop-cli.ts",
    "typecheck": "tsc --noEmit",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "check:brand": "node scripts/build-brand-assets.mjs --check",
    "build:website": "node scripts/build-website.mjs",
    "preview:website": "node scripts/preview-website.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:architecture": "node scripts/source-architecture.mjs --check && pnpm check:dependencies",
    "test": "vitest run",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:desktop": "node scripts/make-desktop.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "publish:desktop": "node scripts/publish-desktop.mjs",
    "test:desktop": "node scripts/workspace-ui-smoke.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "test:loop": "node scripts/loop-smoke.mjs",
    "test:members": "tsx scripts/member-ui-smoke.mts",
    "test:collaboration": "tsx scripts/collaboration-ui-smoke.mts",
    "test:main-instance": "tsx scripts/collaboration-ui-smoke.mts --default-executor",
    "test:agent-history": "tsx scripts/collaboration-ui-smoke.mts --history",
    "test:architecture-ui": "tsx scripts/architecture-ui-smoke.mts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "ajv": "^8.17.1",
    "electron-updater": "6.8.11",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "koffi": "^2.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.58.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi"
    ]
  }
}
