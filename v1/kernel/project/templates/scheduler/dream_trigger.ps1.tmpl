# CBIM dream governance trigger (rendered from dream_trigger.ps1.tmpl).
#
# Fires headless `claude` with a locked-down MCP tool whitelist so an
# unattended Task Scheduler invocation can drive the dream_tick loop
# to completion without risking arbitrary tool use.
#
# Placeholder `{{project_root}}` is replaced with the absolute path of
# the CBIM project root at install time. Do NOT edit this file in place —
# it is regenerated on every `cbim project sync` / `cbim init`.

$ErrorActionPreference = 'Stop'

$ProjectRoot = '{{project_root}}'
$LogDir      = Join-Path $ProjectRoot '.cbim\logs'
$CurrentJson = Join-Path $ProjectRoot '.cbim\scheduler\dream\current.json'

$Stamp   = Get-Date -Format 'yyyy-MM-dd'
$LogFile = Join-Path $LogDir "dream_trigger_${Stamp}.log"

# Best-effort log directory creation; ignore if we can't (log write below
# will surface the real error).
try { New-Item -ItemType Directory -Path $LogDir -Force | Out-Null } catch {}

function Write-Log {
    param([string]$Message)
    $line = "$(Get-Date -Format 'yyyy-MM-ddTHH:mm:ssK') $Message"
    try {
        Add-Content -Path $LogFile -Value $line -Encoding UTF8
    } catch {
        # Log-write failure is not fatal; keep going.
    }
}

Write-Log "trigger start; project_root=$ProjectRoot"

# --- Front gate: respect the engine's single-flight semantics. -------------
# If .cbim/scheduler/dream/current.json says a run is in progress and the
# heartbeat is within 30 minutes, do not start another tick. The dream
# engine itself would return Skipped(another_run_in_progress), but this
# check avoids spinning up a full `claude` process just to be turned away.
if (Test-Path -LiteralPath $CurrentJson) {
    try {
        $current = Get-Content -LiteralPath $CurrentJson -Raw -Encoding UTF8 |
            ConvertFrom-Json
        $status = if ($current) { $current.status } else { $null }
        $hbRaw  = if ($current) { $current.last_heartbeat } else { $null }
        if ($status -eq 'running' -and $hbRaw) {
            $hb = [DateTime]::Parse($hbRaw, [Globalization.CultureInfo]::InvariantCulture,
                                    [Globalization.DateTimeStyles]::RoundtripKind)
            $ageMinutes = ([DateTime]::UtcNow - $hb.ToUniversalTime()).TotalMinutes
            if ($ageMinutes -lt 30) {
                Write-Log "skipped: dream run in progress (heartbeat age ${ageMinutes} min)"
                exit 0
            }
        }
    } catch {
        Write-Log "warning: could not parse current.json: $($_.Exception.Message)"
        # Fall through — better to double-fire than to silently miss a tick.
    }
}

# --- Core call: headless claude with a locked tool whitelist. --------------
$AllowedTools = 'mcp__cbim__dream_tick,mcp__cbim__dream_tick_resume,mcp__cbim__dream_abort,mcp__cbim__dream_list_runs,Task'
$Prompt = 'A governance tick is due. Run dream_tick(reason="catchup") and drive it to completion following the governance loop workflow in CLAUDE.md. Do not respond to me at the end.'

$exitCode = 0
try {
    Push-Location -LiteralPath $ProjectRoot
    try {
        Write-Log "invoking claude --print (allowedTools=$AllowedTools)"
        # Capture stdout+stderr merged; write to log after the process exits.
        $output = & claude --print --allowedTools $AllowedTools $Prompt 2>&1
        $exitCode = $LASTEXITCODE
        if ($output) {
            $joined = ($output | Out-String).TrimEnd()
            if ($joined) { Write-Log "claude output:`n$joined" }
        }
        Write-Log "claude exit code: $exitCode"
    } finally {
        Pop-Location
    }
} catch {
    $exitCode = 1
    Write-Log "trigger error: $($_.Exception.Message)"
}

Write-Log "trigger end; exit=$exitCode"
exit $exitCode
