{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_session_start.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_session_start.py\"; fi"
          },
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_auto_preview.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_auto_preview.py\"; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_session_end.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_session_end.py\"; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_stop.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_stop.py\"; fi"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_subagent_stop.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_subagent_stop.py\"; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_user_prompt_submit.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_user_prompt_submit.py\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_pre_tool_use.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_pre_tool_use.py\"; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if python3 -c \"\" 2>/dev/null; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_post_tool_use.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/cbim_post_tool_use.py\"; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Write(.cbim/**)",
      "Edit(.cbim/**)",
      "Read(.cbim/**)",
      "Bash(.cbim/run *)"
    ]
  }
}
