# Native-.NET layout: src/ tree must be tracked despite parent *.csproj rule
!src/**/*.csproj
!Directory.Build.props
!Directory.Packages.props
!nuget.config
!cbim.sln
!global.json

# Build artefacts under src/
src/**/bin/
src/**/obj/

# Engine behavior-tree resume scratch
.bt-resume-payload*.txt

# JetBrains Rider IDE config — never tracked
.idea/
